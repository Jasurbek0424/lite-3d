---
/** Bitta tugma: yorug' ↔ qorong'i. Starlight'ning `starlight-theme` kalitini ishlatadi. */
import { langFromPath, t } from '../i18n';

const label = t(langFromPath(Astro.url.pathname))['theme.toggle'];
---

<button type="button" class="theme-toggle" aria-label={label} title={label}>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
  </svg>
</button>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {
        // storage yopiq bo'lsa mavzu faqat shu sahifada saqlanadi
      }
    });
  }
</script>

<style>
  .theme-toggle {
    /* header'da joy tor bo'lsa ham doira bo'lib qolsin */
    flex: none;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid transparent;
    background: var(--l3-fill);
    color: var(--l3-text);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--l3-fill-hover);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--l3-accent);
    outline-offset: 2px;
  }
  svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  /* Qorong'ida quyosh (yorug'ga o'tish), yorug'da oy */
  :global([data-theme='light']) .sun,
  :global([data-theme='dark']) .moon {
    display: none;
  }
</style>
