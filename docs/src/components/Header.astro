---
/**
 * Starlight Header o'rniga: logotip, asosiy bo'limlar, qidiruv, til, GitHub, mavzu.
 * Akkaunt/login qismi ataylab yo'q.
 */
import Search from '@astrojs/starlight/components/Search.astro';
import LangSelect from './LangSelect.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { GITHUB_URL } from '../data/models';
import { href, langFromPath, stripLang, t } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const tr = t(lang);
const path = stripLang(Astro.url.pathname);
const links = [
  { href: '/', label: tr['nav.demo'], match: (p: string) => p === '/' },
  { href: '/models/', label: tr['nav.models'], match: (p: string) => p.startsWith('/models') },
  {
    href: '/start/introduction/',
    label: tr['nav.docs'],
    match: (p: string) => /^\/(start|guides|frameworks|reference)\//.test(p),
  },
  { href: '/pricing/', label: tr['nav.pricing'], match: (p: string) => p.startsWith('/pricing') },
];
---

<div class="l3-header">
  <Logo />

  <nav class="main-nav" aria-label={tr['nav.label']}>
    {
      links.map((l) => (
        <a href={href(lang, l.href)} aria-current={l.match(path) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <div class="tools">
    <Search />
    <LangSelect />
    <a class="icon-link" href={GITHUB_URL} aria-label={tr['nav.github']} rel="noopener">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        />
      </svg>
      <span>GitHub</span>
    </a>
    <ThemeToggle />
  </div>

  <details class="mobile-nav">
    <summary aria-label={tr['nav.menu']}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </summary>
    <nav aria-label={tr['nav.label']}>
      {
        links.map((l) => (
          <a href={href(lang, l.href)} aria-current={l.match(path) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={GITHUB_URL} rel="noopener">GitHub</a>
    </nav>
  </details>
</div>

<style>
  .l3-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
    max-width: 88rem;
    margin-inline: auto;
  }

  .main-nav {
    display: none;
    gap: 0.25rem;
  }
  .main-nav a,
  .mobile-nav nav a {
    position: relative;
    padding: 0.5rem 0.8rem;
    border-radius: 8px;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--l3-muted);
    text-decoration: none;
  }
  .main-nav a:hover {
    color: var(--l3-text);
  }
  .main-nav a[aria-current='page'] {
    color: var(--l3-text);
  }
  /* Faol bo'lim: pastidagi ko'k chiziq, mockup'dagidek */
  .main-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: -0.55rem;
    height: 2px;
    border-radius: 2px;
    background: var(--l3-accent);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-start: auto;
  }
  .icon-link {
    display: none;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    border: 1px solid transparent;
    background: var(--l3-fill);
    color: var(--l3-text);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .icon-link:hover {
    background: var(--l3-fill-hover);
  }
  .icon-link svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }
  :is(.main-nav a, .icon-link, .mobile-nav summary, .mobile-nav a):focus-visible {
    outline: 2px solid var(--l3-accent);
    outline-offset: 2px;
  }

  /* Telefon: bo'limlar ochiladigan ro'yxatda */
  .mobile-nav {
    position: relative;
    flex: none;
  }
  /* Hujjat sahifalarida Starlight'ning menyusi bor: bo'limlar uning pastida (MobileMenuFooter) */
  :global([data-has-sidebar]) .mobile-nav {
    display: none;
  }
  .mobile-nav summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid transparent;
    background: var(--l3-fill);
    cursor: pointer;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav summary svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--l3-text);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .mobile-nav nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 20;
    display: grid;
    min-width: 12rem;
    padding: 0.4rem;
    border-radius: 12px;
    border: 1px solid transparent;
    background: var(--l3-surface);
    box-shadow: var(--l3-shadow);
  }
  .mobile-nav nav a[aria-current='page'] {
    color: var(--l3-text);
    background: var(--l3-accent-soft);
  }

  @media (min-width: 56rem) {
    .main-nav {
      display: flex;
    }
    .icon-link {
      display: inline-flex;
    }
    .mobile-nav {
      display: none;
    }
  }
  /* Hujjat sahifalarida chap tomonda Starlight'ning o'z menyu tugmasi bor */
  @media (max-width: 49.99rem) {
    .l3-header {
      gap: 0.75rem;
    }
    .tools :global(site-search) {
      flex: 0 0 auto;
    }
  }
</style>
